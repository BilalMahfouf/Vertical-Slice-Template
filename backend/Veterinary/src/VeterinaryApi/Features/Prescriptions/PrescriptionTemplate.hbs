<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Prescription Vétérinaire</title>
<style>
    @page {
        size: A4;
        margin: 0;
    }

    body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        -webkit-print-color-adjust: exact;
    }

    /* Main Container */
    .page {
        width: 210mm;
        min-height: 297mm;
        padding: 15mm 20mm;
        margin: 0 auto;
        position: relative;
        box-sizing: border-box;
    }

    /* ----------------------------------------------------
       HEADER SECTION
       ---------------------------------------------------- */
    .header-table {
        width: 100%;
        border-bottom: 3px double #005f9e; /* Professional heavy line */
        padding-bottom: 15px;
        margin-bottom: 10px;
    }

    .header-left {
        width: 60%;
        vertical-align: top;
        text-align: left;
    }

    .header-right {
        width: 40%;
        vertical-align: top;
        text-align: right;
    }

    .doctor-name {
        font-size: 16pt;
        font-weight: 800;
        color: #005f9e;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .sub-text {
        font-size: 10pt;
        color: #555;
        line-height: 1.3;
    }

    .arabic-text {
        font-family: 'Courier New', Courier, monospace; /* Fallback for Arabic if specific font not available */
        direction: rtl; 
    }

    /* ----------------------------------------------------
       TITLE
       ---------------------------------------------------- */
    .doc-title {
        text-align: center;
        margin: 20px 0 30px 0;
    }

    .doc-title h1 {
        margin: 0;
        font-size: 24pt;
        color: #005f9e;
        font-weight: 900;
        text-transform: uppercase;
/*        border: 2px solid #333;*/
        display: inline-block;
        padding: 5px 20px;
/*        border-radius: 4px;*/
    }
    
    .doc-title span {
        display: block;
        font-size: 14pt;
        margin-top: 5px;
        font-weight: bold;
    }

    /* ----------------------------------------------------
       INFO GRID (Patient Details)
       Using tables ensures alignment in PDF generators
       ---------------------------------------------------- */
    .info-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        font-size: 11pt;
    }

    .info-table td {
        padding: 8px 5px;
        vertical-align: bottom;
    }

    .label {
        font-weight: bold;
        color: #444;
        white-space: nowrap;
        width: 1%;
    }

    .value {
/*        border-bottom: 1px dotted #000;*/
        font-weight: 600;
        color: #000;
        padding-left: 10px;
        width: 45%; 
        font-family: 'Courier New', monospace; /* Looks like typed data */
    }

    .label-ar {
        text-align: right;
        direction: rtl;
        width: 1%;
        white-space: nowrap;
        font-weight: bold;
    }

    /* ----------------------------------------------------
       MEDICINE LIST
       ---------------------------------------------------- */
    .rx-section {
        margin-top: 10px;
        position: relative;
        min-height: 500px; /* Ensure space for content */
    }

    .rx-header {
        font-size: 32pt;
        font-family: 'Times New Roman', serif;
        font-style: italic;
        font-weight: bold;
        margin-bottom: 15px;
    }

    /* Numbered list styling without relying on <ol> padding quirks */
    .med-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 15px; /* Space between rows */
    }

    .med-number {
        width: 30px;
        vertical-align: top;
        font-weight: bold;
        font-size: 14pt;
        color: #005f9e;
    }

    .med-content {
        vertical-align: top;
        font-size: 12pt;
        line-height: 1.5;
        border-bottom: 1px solid #eee;
        padding-bottom: 5px;
    }

    /* ----------------------------------------------------
       FOOTER
       ---------------------------------------------------- */
    .footer-wrap {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 0 20mm 20mm 20mm; /* Match body padding */
        box-sizing: border-box;
    }

    .signature-area {
        text-align: right;
        margin-bottom: 20px;
        padding-right: 20px;
    }

    .signature-line {
        display: inline-block;
        width: 200px;
        border-top: 1px solid #333;
        padding-top: 5px;
        text-align: center;
        font-weight: bold;
    }

    .footer-info {
        border-top: 2px solid #005f9e;
        padding-top: 10px;
        text-align: center;
        font-size: 9pt;
        color: #666;
        width: 100%;
    }
</style>
</head>
<body>

<div class="page">

    <!-- Header -->
    <table class="header-table">
        <tr>
            <td class="header-left">
                <div class="doctor-name">Dr. {{doctorName}}</div>
                <div class="sub-text">
                    <strong>{{cabinetName}}</strong><br>
                    Médecine & Chirurgie Vétérinaire<br>
                    {{address}}<br>
                    Tél: {{phone}}
                </div>
            </td>
            <td class="header-right">
                <div class="sub-text arabic-text">
                    عيادة الطب البيطري<br>
                    {{address}}<br>
                    تلقيح - جراحة - تحاليل
                </div>
            </td>
        </tr>
    </table>

    <!-- Title -->
    <div class="doc-title">
        <h1>ORDONNANCE</h1>
        <!--<span class="arabic-text">وصفة طبية</span>-->
    </div>

    <!-- Patient Info Grid -->
    <table class="info-table">
        <tr>
            <!-- Row 1 -->
            <td class="label">Date:</td>
            <td class="value">{{date}}</td>
            <td class="label-ar">التاريخ</td>
            
            <td width="20"></td> <!-- Spacer -->

            <td class="label">Propriétaire:</td>
            <td class="value">{{patientFullName}}</td>
            <td class="label-ar">المالك</td>
        </tr>
        <tr>
            <!-- Row 2 -->
            <td class="label">Espèce:</td>
            <td class="value">{{animalType}}</td>
            <td class="label-ar">النوع</td>

             <td width="20"></td> <!-- Spacer -->

            <td class="label">Poids/Age:</td>
            <td class="value">{{patientWeight}} / {{patientAge}}</td>
            <td class="label-ar">الوزن/العمر</td>
        </tr>
    </table>

    <!-- Medicines -->
    <div class="rx-section">
        <div class="rx-header"></div>
        
        <table class="med-table">
            {{#each medicines}}
            <tr>
                <!-- Use CSS counter if index isn't available, but simple bullet is safer -->
                <td class="med-number">.</td> 
                <td class="med-content">{{this}}</td>
            </tr>
            {{/each}}
        </table>
    </div>

    <!-- Footer Area -->
    <div class="footer-wrap">
        
        <div class="signature-area">
            <div class="signature-line">
                Signature / Cachet<br>
                <span class="arabic-text">الإمضاء</span>
            </div>
        </div>

        <div class="footer-info">
            {{cabinetName}} <br>
            <strong>Urgence / Emergency: {{phone}}</strong>
        </div>
    </div>

</div>

</body>
</html>